# Server-only. Never prefix these variables with NEXT_PUBLIC_.
# Supabase Connect > Transaction pooler; password must be URL-encoded.
DATABASE_URL=
# Optional PEM CA certificate if required by your PostgreSQL provider.
DATABASE_CA_CERT=
# At least 32 random characters. Changing this invalidates all sessions.
SESSION_SECRET=
# Different passwords of at least 12 characters. Configure in Vercel, not Git.
OPERATOR_PASSWORD=
ADMIN_PASSWORD=
# Google Cloud service account; share the sheet with this email as Editor.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
